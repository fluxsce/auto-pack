{
  "name": "auto-pack",
  "version": "2.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-version": "node script/sync-version.mjs",
    "predev": "node script/sync-version.mjs",
    "predev:server": "node script/sync-version.mjs",
    "prebuild": "node script/sync-version.mjs",
    "pretest:server": "node script/sync-version.mjs",
    "prepackage:windows": "node script/sync-version.mjs",
    "prepackage:linux": "node script/sync-version.mjs",
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"go run -C server ./cmd\"",
    "dev:web": "vite",
    "dev:server": "go run -C server ./cmd",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File script/build/windows.ps1",
    "package:linux": "bash script/build/linux.sh",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:server": "go test -C server ./..."
  },
  "dependencies": {
    "@niuma/ui": "link:../niuma-ui",
    "axios": "^1.13.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
